{
	// Prettier (and CI) require a final newline; let the editor add it on save.
	"files.insertFinalNewline": true,
	"files.associations": {
		"*.css": "tailwindcss"
	},
	// The frontend lives in a subfolder; ESLint must run from there to find its config.
	"eslint.workingDirectories": ["frontend"],
	"[svelte]": { "editor.defaultFormatter": "svelte.svelte-vscode" },
	"[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" }
}
